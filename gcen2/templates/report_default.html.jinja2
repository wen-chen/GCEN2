<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GCEN2 Analysis Report</title>
<style>
  body { font-family: Arial, sans-serif; max-width: 1200px; margin: 0 auto; padding: 20px; color: #333; }
  h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; }
  h2 { color: #2980b9; margin-top: 40px; }
  table { border-collapse: collapse; width: 100%; margin: 15px 0; }
  th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
  th { background-color: #3498db; color: white; }
  tr:nth-child(even) { background-color: #f5f5f5; }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin: 20px 0; }
  .stat-card { background: #ecf0f1; border-radius: 8px; padding: 15px; text-align: center; }
  .stat-value { font-size: 24px; font-weight: bold; color: #2980b9; }
  .stat-label { font-size: 12px; color: #7f8c8d; margin-top: 5px; }
  img { max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; }
  figure.gcen2-figure { margin: 24px 0; page-break-inside: avoid; }
  figure.gcen2-figure svg { max-width: 100%; height: auto; display: block; margin: 0 auto; }
  .figure-caption { color: #555; font-size: 13px; margin-top: 6px; line-height: 1.4; }
  .figure-caption b { color: #333; }
  .badge { display: inline-block; padding: 3px 8px; border-radius: 4px; font-size: 12px; }
  .badge-info { background: #3498db; color: white; }
  footer { margin-top: 60px; padding-top: 20px; border-top: 1px solid #ddd; color: #999; font-size: 12px; }
</style>
</head>
<body>

{% macro show(f, n) %}
<figure class="gcen2-figure">
  {{ f.svg | safe }}
  <figcaption class="figure-caption"><b>Figure {{ n }}.</b> {{ f.caption }}</figcaption>
</figure>
{% endmacro %}
{% set ns = namespace(fig=0) %}
<h1>GCEN2 Analysis Report</h1>
<p>Generated by GCEN2 v{{ gcen2_version }}</p>

{% if expr_qc %}
<h2>1. Data Quality Control</h2>
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-value">{{ expr_qc.gene_count }}</div>
    <div class="stat-label">Genes</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">{{ expr_qc.sample_count }}</div>
    <div class="stat-label">Samples</div>
  </div>
  <div class="stat-card">
    <div class="stat-value">{{ expr_qc.normalization_method or "None" }}</div>
    <div class="stat-label">Normalization</div>
  </div>
</div>
{% if figures.expr_qc %}{% set ns.fig = ns.fig + 1 %}{{ show(figures.expr_qc, ns.fig) }}{% endif %}
{% endif %}

{% if network_stats %}
<h2>2. Network Overview</h2>
<div class="stats-grid">
  <div class="stat-card"><div class="stat-value">{{ network_stats.node_count }}</div><div class="stat-label">Nodes (Genes)</div></div>
  <div class="stat-card"><div class="stat-value">{{ network_stats.edge_count }}</div><div class="stat-label">Edges</div></div>
  <div class="stat-card"><div class="stat-value">{{ "%.4f" | format(network_stats.density) }}</div><div class="stat-label">Density</div></div>
  <div class="stat-card"><div class="stat-value">{{ "%.2f" | format(network_stats.average_degree) }}</div><div class="stat-label">Avg Degree</div></div>
  <div class="stat-card"><div class="stat-value">{{ network_stats.connected_components }}</div><div class="stat-label">Components</div></div>
  <div class="stat-card"><div class="stat-value">{{ "%.4f" | format(network_stats.clustering_coefficient) }}</div><div class="stat-label">Clustering Coeff</div></div>
</div>
{% if figures.degree_distribution %}{% set ns.fig = ns.fig + 1 %}{{ show(figures.degree_distribution, ns.fig) }}{% endif %}
{% endif %}

{% if figures.merge_overlap or figures.extract_overview %}
<h2>2b. Merged and Extracted Networks</h2>
{% if figures.merge_overlap %}{% set ns.fig = ns.fig + 1 %}{{ show(figures.merge_overlap, ns.fig) }}{% endif %}
{% if figures.extract_overview %}{% set ns.fig = ns.fig + 1 %}{{ show(figures.extract_overview, ns.fig) }}{% endif %}
{% endif %}

{% if figures.moran %}
<h2>2c. Spatial Autocorrelation</h2>
{% set ns.fig = ns.fig + 1 %}{{ show(figures.moran, ns.fig) }}
{% endif %}

{% if modules %}
<h2>3. Module Results</h2>
<p><strong>Total modules:</strong> {{ modules.module_count }}</p>
<table>
  <thead><tr><th>Module</th><th>Size</th><th>Top Genes (up to 10)</th></tr></thead>
  <tbody>
  {% for mod in modules.modules[:20] %}
  <tr>
    <td>{{ loop.index0 }}</td>
    <td>{{ mod|length }}</td>
    <td>{{ (mod | sort)[:10] | join(", ") }}{% if mod|length > 10 %} ...{% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% if figures.module_sizes %}{% set ns.fig = ns.fig + 1 %}{{ show(figures.module_sizes, ns.fig) }}{% endif %}
{% endif %}

{% if wgcna %}
<h2>3b. WGCNA-style Modules</h2>
{% for f in celltype_figures or [] %}{% set ns.fig = ns.fig + 1 %}{{ show(f, ns.fig) }}{% endfor %}
{% for sec in wgcna %}
<h3>{{ sec.title }}</h3>
<p>{% if sec.note %}{{ sec.note }}; {% endif %}<strong>{{ sec.n_modules }}</strong> modules,
{{ sec.n_genes }} genes in modules.</p>
<table>
  <thead><tr><th>Module</th><th>Size</th><th>{% if sec.rows and sec.rows[0].hubs is not none %}Hub genes (highest kME){% else %}Genes (up to 10){% endif %}</th></tr></thead>
  <tbody>
  {% for row in sec.rows[:30] %}
  <tr>
    <td>{{ row.module }}</td>
    <td>{{ row.size }}</td>
    <td>{% if row.hubs is not none %}{{ row.hubs | join(", ") }}{% else %}{{ row.genes | join(", ") }}{% if row.more %} ...{% endif %}{% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% for f in sec.figures %}{% set ns.fig = ns.fig + 1 %}{{ show(f, ns.fig) }}{% endfor %}
{% if sec.trait_top %}
<table>
  <thead><tr><th>Module</th><th>Trait</th><th>r</th><th>p</th><th>n</th></tr></thead>
  <tbody>
  {% for t in sec.trait_top %}
  <tr><td>{{ t.module }}</td><td>{{ t.trait }}</td><td>{{ "%.3f" | format(t.cor) }}</td><td>{{ "%.2e" | format(t.p) }}</td><td>{{ t.n }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
{% endfor %}
{% endif %}

{% if enrichment %}
<h2>4. Functional Annotation</h2>
{% if figures.dotplot %}{% set ns.fig = ns.fig + 1 %}{{ show(figures.dotplot, ns.fig) }}{% endif %}
{% endif %}

{% if rwr %}
<h2>5. RWR Predictions</h2>
<p><strong>Seed genes:</strong> {{ rwr.seed_genes | join(", ") }}</p>
<p><strong>Restart probability (γ):</strong> {{ rwr.gamma }}</p>
{% if figures.rwr %}{% set ns.fig = ns.fig + 1 %}{{ show(figures.rwr, ns.fig) }}{% endif %}
<table>
  <thead><tr><th>Rank</th><th>Gene</th><th>Probability</th></tr></thead>
  <tbody>
  {% for i, row in rwr.ranked_genes.head(50).iterrows() %}
  <tr><td>{{ loop.index }}</td><td>{{ row.gene }}</td><td>{{ "%.6f" | format(row.probability) }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>6. Methods Summary</h2>
<p>This analysis was performed using GCEN2 v{{ gcen2_version }}.
{% if network %}Network was built using the {{ network.method }} correlation method
(signed={{ network.is_signed }}).{% endif %}
{% if modules %}Module identification used a Jaccard similarity cutoff of {{ modules.similarity_cutoff }}.{% endif %}
{% if wgcna %}WGCNA-style modules were identified from the topological overlap (soft-thresholded
correlations), average-linkage clustering and the dynamic tree cut, with eigengene-based merging
(GCEN2 <code>module -e</code> / <code>celltype-modules</code>, following WGCNA / hdWGCNA).{% endif %}
</p>

<footer>
  <p>Generated by <a href="https://github.com/wen-chen/GCEN2">GCEN2</a> v{{ gcen2_version }} &mdash;
  Wen Harold Chen, Hunan University of Chinese Medicine</p>
</footer>

</body>
</html>
